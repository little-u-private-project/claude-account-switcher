{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seatdeck",
  "identifier": "com.littleusagi.claude-accounts",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Seatdeck",
        "width": 460,
        "height": 600,
        "minWidth": 380,
        "minHeight": 360,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "version": "4.3.0",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMzRBMDc2MEVDNDM3NjUKUldSbE44UU9kcUEwbXNhRlBPWjR6a2FZbkgzMFpTd2k4OTZhaXIybXdlNnVZNWpwdXJ3aTFkRkMK",
      "endpoints": [
        "https://github.com/little-u-private-project/claude-account-switcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
